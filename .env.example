# ==========================================
# KONFIGURASI SIAKANUDA v1.9.0
# Salin file ini menjadi '.env' dan isi nilainya.
# JANGAN pernah commit file .env ke Git!
# ==========================================

# --- SERVER ---
# Port background API (WA Bot, PDF, Cron, Sync).
# Dashboard CI4 ada di port 8080 (terpisah via php spark serve).
PORT=7860

# Nama sekolah (tampil di dashboard & pesan WA)
SCHOOL_NAME=SMK NU Darussalam

# --- DATABASE LOKAL (SQLite) ---
# DB file otomatis dibuat jika belum ada.
# DB_PATH=./siakanuda.db  (default, tidak perlu diisi)

# --- CLOUD DATABASE (Supabase) ---
# Untuk backup foto PKL ke cloud.
# Dapatkan dari: supabase.com -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=pkl-photos

# --- WHATSAPP BOT ---
# Mode Pengujian Bot:
# - true  : Notifikasi guru pembimbing dialihkan ke nomor admin (preview saja)
# - false : Notifikasi langsung ke nomor WA guru pembimbing (Production)
TESTING_MODE=true

# Nama bot WA (tampil di log)
BOT_NAME=SIAKANUDA Bot

# Nama sesi WA (untuk multi-device auth)
WA_SESSION_NAME=siakanuda-bot

# Target grup WA untuk broadcast (JID format: xxxxx@g.us)
# Bisa diatur dari dashboard Pengaturan WA (port 8080)
BROADCAST_GROUP_JID=
SCHOOL_GROUP_JID=

# --- KEAMANAN & AUTH ---
# Secret key untuk JWT token (generate random string panjang)
JWT_SECRET=

# Base URL dashboard CI4 (untuk link di pesan WA)
BASE_URL=http://localhost:8080

# Password dashboard WA Panel (port 7860)
DASHBOARD_PASSWORD=

# --- GOOGLE APPS SCRIPT (v1.9.0) ---
# URL Web App GAS untuk offload pembuatan PDF laporan PKL harian
# Kosongkan jika belum setup GAS (akan fallback ke PDF lokal)
GAS_PDF_URL=
