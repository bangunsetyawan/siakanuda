{
    "name": "smknuda/siakanuda-dashboard",
    "description": "SIAKANUDA — Dashboard Sistem Informasi Akademik SMK NU Darussalam (CodeIgniter 4)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "scripts": {
        "post-update-cmd": [
            "@php spark migrate --all 2>/dev/null ; exit 0"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
