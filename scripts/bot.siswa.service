[Unit]
Description=SIAKANUDA — Sistem Informasi Akademik SMK NU Darussalam
Documentation=https://github.com/siakanuda
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ============================================================
# GANTI 'user' dengan username Linux Anda di Debian
# Contoh: User=bangun   (jika login sebagai 'bangun')
# Cek dengan perintah: whoami
# ============================================================
User=smknuda
Group=smknuda

# ============================================================
# GANTI path ini sesuai lokasi instalasi di Debian
# Contoh: /home/bangun/siakanuda-v1.0.0
# ============================================================
WorkingDirectory=/home/smknuda/siakanuda

# Jalankan dengan node langsung (bukan npm run dev, bukan --watch)
# --env-file=.env memuat variabel dari .env secara otomatis
ExecStart=/usr/bin/node --env-file=.env execution/server.js

# Restart otomatis jika crash (termasuk error tak terduga)
Restart=always
RestartSec=5

# Batasi restart berlebihan: maks 5 kali dalam 60 detik
# Jika terlewati, service masuk ke state 'failed' sampai direset manual
StartLimitIntervalSec=60
StartLimitBurst=5

# Environment
Environment=NODE_ENV=production

# Logging: output & error masuk ke systemd journal
# Pantau live: journalctl -u siswabot -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=siswabot

# Keamanan dasar (opsional tapi dianjurkan)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
